# SQLite for local development (default)
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL (Supabase / Neon / i2i)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Admin auth (CAKE-10)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-a-long-random-secret"

# Password recovery email (SMTP) — optional; backup recovery code is configured after first admin login
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-account@example.com"
SMTP_PASSWORD="replace-with-an-app-password"
SMTP_FROM="Consumer Remuneration Tool <no-reply@example.com>"
