# SQLite is no longer used. Local/dev/prod share PostgreSQL (Docker Compose or hosted).
# Example local Docker DB:
DATABASE_URL="postgresql://cake:cake@localhost:5432/cake?schema=public"

# Admin auth (CAKE-10)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_RECOVERY_CODE="replace-with-a-supervisor-recovery-code"

# Password recovery email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-account@example.com"
SMTP_PASSWORD="replace-with-an-app-password"
SMTP_FROM="Consumer Remuneration Tool <no-reply@example.com>"

# Docker only: seed evidence rows on container start (set false after first boot)
RUN_SEED="true"
