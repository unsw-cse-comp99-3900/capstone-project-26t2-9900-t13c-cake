# SQLite is no longer used. Local/dev/prod share PostgreSQL (Docker Compose or hosted).
# Example local Docker DB:
DATABASE_URL="postgresql://cake:cake@localhost:5432/cake?schema=public"

# Admin auth (CAKE-10)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-a-long-random-secret"
# Session cookie Secure flag:
# - false for local Docker / http://localhost:3000
# - true when the site is served over HTTPS (use with docker-compose.prod.yml)
AUTH_COOKIE_SECURE="false"

# Password recovery email (SMTP) — optional; backup recovery code is configured after first admin login
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-account@example.com"
SMTP_PASSWORD="replace-with-an-app-password"
SMTP_FROM="Consumer Remuneration Tool <no-reply@example.com>"

# Docker only: seed evidence rows on container start (set false after first boot)
RUN_SEED="true"
