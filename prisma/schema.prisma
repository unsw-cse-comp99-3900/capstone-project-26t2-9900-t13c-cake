generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Evidence-table row mirroring supervisor Excel columns (CAKE-2).
model EvidenceRecord {
  id                       String    @id @default(cuid())
  publisher                String
  title                    String
  year                     Int?
  link                     String?
  /// Comma-separated jurisdictions, e.g. "National,NSW"
  jurisdictions            String
  context                  String
  subCategory              String?
  engagementLevel          String
  minHourlyRate            Float?
  maxHourlyRate            Float?
  reimbursementGuidance    Boolean   @default(false)
  unpaidEngagementGuidance Boolean   @default(false)
  exampleOrganisations     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  @@index([deletedAt])
  @@index([context, engagementLevel])
  @@map("evidence_records")
}

/// Anonymous feedback survey response (CAKE-15).
model AnonymousFeedback {
  id               String   @id @default(cuid())
  rating           Int
  partOfTool       String?
  workedWell       String?
  improvement      String?
  consentConfirmed Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("anonymous_feedback")
}

/// Singleton administrator credentials (CAKE-10).
model AdminAccount {
  id                    String    @id @default("default")
  username              String    @unique
  passwordHash          String
  recoveryEmail         String?
  recoveryCodeHash      String?
  recoveryCodeExpiresAt DateTime?
  recoveryCodeSentAt    DateTime?
  recoveryCodeAttempts  Int       @default(0)
  backupRecoveryCodeHash        String?
  backupRecoveryCodeCreatedAt   DateTime?
  backupRecoveryCodeConfirmedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("admin_account")
}
