generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Evidence-table row mirroring supervisor Excel columns (CAKE-2).
model EvidenceRecord {
  id                       String    @id @default(cuid())
  publisher                String
  title                    String
  year                     Int?
  link                     String?
  /// Comma-separated jurisdictions, e.g. "National,NSW"
  jurisdictions            String
  context                  String
  subCategory              String?
  engagementLevel          String
  minHourlyRate            Float?
  maxHourlyRate            Float?
  reimbursementGuidance    Boolean   @default(false)
  unpaidEngagementGuidance Boolean   @default(false)
  exampleOrganisations     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  @@index([deletedAt])
  @@index([context, engagementLevel])
  @@map("evidence_records")
}

/// Singleton administrator credentials (CAKE-10).
model AdminAccount {
  id           String   @id @default("default")
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_account")
}

/// Anonymous public website usage events for administrator analytics.
model WebsiteUsageEvent {
  id        String   @id
  eventType String
  path      String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([path, createdAt])
  @@map("website_usage_events")
}
